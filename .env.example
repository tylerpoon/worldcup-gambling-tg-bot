# --- Telegram ---
# Get this from @BotFather: /newbot
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Your numeric Telegram user id (admin). DM @userinfobot to find it.
# Comma-separate for multiple admins.
ADMIN_IDS=123456789

# --- The Odds API (https://the-odds-api.com) ---
ODDS_API_KEY=your-the-odds-api-key

# Competition to bet on. Premier League = soccer_epl.
# Other examples: soccer_uefa_champs_league, soccer_spain_la_liga,
# soccer_fifa_world_cup. Full list:
# https://api.the-odds-api.com/v4/sports?apiKey=YOUR_KEY
SPORT_KEY=soccer_epl
# Friendly name shown in bot messages (keep it in sync with SPORT_KEY).
LEAGUE_NAME=Premier League

# Region for bookmaker odds: us, uk, eu, or au (uk has the most EPL books)
ODDS_REGION=uk

# --- Game settings ---
STARTING_BALANCE=10000
# How often (seconds) to poll for finished matches and settle bets.
# The bot only hits the API during live match windows, so 1800 (30 min) is
# both responsive and free-tier friendly. See README "API quota".
SETTLE_INTERVAL=1800
# How often (seconds) to auto-refresh fixtures & odds. A league runs all season,
# so new gameweeks need pulling in periodically. 21600 = every 6 hours.
SYNC_INTERVAL=21600
# Database file
DB_PATH=epl.db
