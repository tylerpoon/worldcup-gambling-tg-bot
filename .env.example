# --- Telegram ---
# Get this from @BotFather: /newbot
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Your numeric Telegram user id (admin). DM @userinfobot to find it.
# Comma-separate for multiple admins.
ADMIN_IDS=123456789

# --- The Odds API (https://the-odds-api.com) ---
ODDS_API_KEY=your-the-odds-api-key

# Sport key for the tournament. World Cup = soccer_fifa_world_cup.
# Full list: https://api.the-odds-api.com/v4/sports?apiKey=YOUR_KEY
SPORT_KEY=soccer_fifa_world_cup

# Region for bookmaker odds: us, uk, eu, or au
ODDS_REGION=eu

# --- Game settings ---
STARTING_BALANCE=10000
# How often (seconds) to poll for finished matches and settle bets.
# The bot only hits the API during live match windows, so 1800 (30 min) is
# both responsive and free-tier friendly. See README "API quota".
SETTLE_INTERVAL=1800
# Database file
DB_PATH=worldcup.db
